# Config Synapse v1.155.0. Défauts vérifiés dans la doc de cette version
# (element-hq.github.io/synapse/v1.155/usage/configuration/config_documentation.html)
# avant tout override ci-dessous — voir infra/README.md.

server_name: "${SERVER_NAME}"
pid_file: /data/homeserver.pid
public_baseurl: "https://${SERVER_NAME}/"
report_stats: false
media_store_path: /data/media_store

listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true # derrière le reverse proxy (spec 01), TLS terminée là-bas
    resources:
      - names: [client]
        compress: false
    # Pas de resource "federation" : fédération désactivée (REQ-INF-02), inutile de l'exposer.

database:
  name: psycopg2
  args:
    user: "${POSTGRES_USER}"
    password: "${POSTGRES_PASSWORD}"
    database: synapse
    host: postgres
    port: 5432
    cp_min: 5
    cp_max: 10

# REQ-INF-02 — application fermée, jamais fédérée.
federation_domain_whitelist: []

# REQ-INF-03 — chiffrement par défaut sur tout nouveau salon, irréversible mais non rétroactif.
encryption_enabled_by_default_for_room_type: all

# REQ-INF-04 — pas d'auto-inscription ; comptes créés via le script d'admin documenté
# dans infra/README.md (register_new_matrix_user, avec ce secret).
enable_registration: false
registration_shared_secret: "${SYNAPSE_REGISTRATION_SHARED_SECRET}"

macaroon_secret_key: "${SYNAPSE_MACAROON_SECRET_KEY}"
form_secret: "${SYNAPSE_FORM_SECRET}"

# REQ-INF-05 — rate limiting desserré, >= 10x les défauts documentés (voir infra/README.md
# pour les valeurs par défaut relevées sur cette version).
rc_message:
  per_second: 2.0 # défaut 0.2
  burst_count: 100 # défaut 10

rc_login:
  address:
    per_second: 0.03 # défaut 0.003
    burst_count: 50 # défaut 5
  account:
    per_second: 0.03 # défaut 0.003
    burst_count: 50 # défaut 5
  failed_attempts:
    per_second: 1.7 # défaut 0.17
    burst_count: 30 # défaut 3

rc_joins:
  local:
    per_second: 1.0 # défaut 0.1
    burst_count: 100 # défaut 10
  remote:
    per_second: 0.1 # défaut 0.01
    burst_count: 100 # défaut 10

rc_invites:
  per_room:
    per_second: 3.0 # défaut 0.3
    burst_count: 100 # défaut 10
  per_user:
    per_second: 0.03 # défaut 0.003
    burst_count: 50 # défaut 5
  per_issuer:
    per_second: 3.0 # défaut 0.3
    burst_count: 100 # défaut 10

# REQ-INF-06 — le défaut (50M) est insuffisant pour le partage de fichiers.
max_upload_size: 200M

# REQ-INF-07 — DECISIONS D-02 : rétention illimitée, identique DM/groupes, bloc présent
# explicitement (pas d'absence par omission). max_lifetime null + purge_jobs vide =
# aucune purge programmée, jamais.
retention:
  enabled: true
  default_policy:
    min_lifetime: null
    max_lifetime: null
  purge_jobs: []

# REQ-INF-08 — backend média S3, blobs opaques uniquement (chiffrement client, spec 08).
# SSE-S3 activé au niveau du bucket (infra/docker-compose.yml, service minio-init) :
# défense en profondeur uniquement, l'opérateur détient ces clés — voir infra/LIMITES.md.
media_storage_providers:
  - module: s3_storage_provider.S3StorageProviderBackend
    store_local: true
    store_remote: true
    store_synchronous: true
    config:
      bucket: "${S3_BUCKET}"
      endpoint_url: "http://minio:9000"
      access_key_id: "${S3_ACCESS_KEY_ID}"
      secret_access_key: "${S3_SECRET_ACCESS_KEY}"

# REQ-INF-09 — seul fournisseur d'authentification : OIDC (Keycloak). Pas de mot de passe
# natif Synapse ; email/pseudo/WebAuthn gérés dans le realm Keycloak (infra/keycloak/).
password_config:
  enabled: false

oidc_providers:
  - idp_id: keycloak
    idp_name: "Compte"
    issuer: "https://${SERVER_NAME}/auth/realms/tacita"
    client_id: synapse
    client_secret: "${KEYCLOAK_OIDC_CLIENT_SECRET}"
    scopes: ["openid", "profile"]
    user_mapping_provider:
      config:
        localpart_template: "{{ user.preferred_username }}"
        display_name_template: "{{ user.preferred_username }}"

# Rétro-compatibilité media non-authentifiée : comportement vérifié pour v1.155.0
# dans infra/README.md (REQ-INF-12).
