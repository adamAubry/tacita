# Config Synapse v1.155.0. Défauts vérifiés dans la doc de cette version
# (element-hq.github.io/synapse/v1.155/usage/configuration/config_documentation.html)
# avant tout override ci-dessous — voir infra/README.md.

server_name: "${SERVER_NAME}"
pid_file: /data/homeserver.pid
public_baseurl: "https://${SERVER_NAME}/"

# REQ-INF-09 — **où le client a le droit de revenir après le SSO.**
#
# Par défaut, Synapse n'accepte de renvoyer le jeton de connexion que vers l'origine de
# `public_baseurl`. Or le proxy n'a volontairement aucun `location /` : le shard (spec 11)
# est servi ailleurs, sur sa propre origine. Sans cette liste, le retour d'OIDC s'arrête
# sur `/_synapse/client/oidc/callback` et l'utilisateur ne revient jamais dans l'app —
# alors que `GET /login/sso/redirect` répond bien 302 et que tout paraît correct.
#
# Trouvé le 07/08/2026 en pilotant le vrai formulaire Keycloak dans un navigateur : la
# fumée s'arrêtait à la redirection *vers* Keycloak et ne voyait pas le retour.
# `SHARD_ORIGIN` vide (défaut) = shard servi sur le domaine du homeserver, rien à ouvrir.
# Rendu en séquence YAML « flow » sur une seule ligne : le gabarit reste du YAML valide,
# donc relisible par les tests d'infra. Une entrée vide serait pire qu'absente — Synapse
# compare la liste **par préfixe**, et `""` est le préfixe de toute URL.
sso:
  client_whitelist: ${SSO_CLIENT_WHITELIST}
report_stats: false
media_store_path: /data/media_store

listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true # derrière le reverse proxy (spec 01), TLS terminée là-bas
    resources:
      - names: [client]
        compress: false
    # Pas de resource "federation" : fédération désactivée (REQ-INF-02), inutile de l'exposer.

database:
  name: psycopg2
  args:
    user: "${POSTGRES_USER}"
    password: "${POSTGRES_PASSWORD}"
    database: synapse
    host: postgres
    port: 5432
    cp_min: 5
    cp_max: 10

# REQ-INF-02 — application fermée, jamais fédérée.
federation_domain_whitelist: []

# REQ-INF-03 — chiffrement par défaut sur tout nouveau salon, irréversible mais non rétroactif.
encryption_enabled_by_default_for_room_type: all

# REQ-INF-04 — pas d'auto-inscription ; comptes créés via le script d'admin documenté
# dans infra/README.md (register_new_matrix_user, avec ce secret).
enable_registration: false
registration_shared_secret: "${SYNAPSE_REGISTRATION_SHARED_SECRET}"

macaroon_secret_key: "${SYNAPSE_MACAROON_SECRET_KEY}"
form_secret: "${SYNAPSE_FORM_SECRET}"

# REQ-INF-05 — rate limiting desserré, >= 10x les défauts documentés (voir infra/README.md
# pour les valeurs par défaut relevées sur cette version).
rc_message:
  per_second: 2.0 # défaut 0.2
  burst_count: 100 # défaut 10

rc_login:
  address:
    per_second: 0.03 # défaut 0.003
    burst_count: 50 # défaut 5
  account:
    per_second: 0.03 # défaut 0.003
    burst_count: 50 # défaut 5
  failed_attempts:
    per_second: 1.7 # défaut 0.17
    burst_count: 30 # défaut 3

rc_joins:
  local:
    per_second: 1.0 # défaut 0.1
    burst_count: 100 # défaut 10
  remote:
    per_second: 0.1 # défaut 0.01
    burst_count: 100 # défaut 10

rc_invites:
  per_room:
    per_second: 3.0 # défaut 0.3
    burst_count: 100 # défaut 10
  per_user:
    per_second: 0.03 # défaut 0.003
    burst_count: 50 # défaut 5
  per_issuer:
    per_second: 3.0 # défaut 0.3
    burst_count: 100 # défaut 10

# REQ-INF-06 — le défaut (50M) est insuffisant pour le partage de fichiers.
max_upload_size: 200M

# REQ-INF-18 — **l'annuaire couvre tous les comptes du serveur** (escalade E-21, tranchée
# par le PM le 21/08/2026).
#
# Le défaut de Synapse (`search_all_users: false`) ne montre que les gens avec qui on
# partage déjà un salon, ou qui sont dans un salon public — et ce déploiement n'en a
# aucun. Conséquence mesurée le 07/08/2026 contre un vrai Synapse : l'annuaire rendait
# `results: []` pour un compte qui existe, donc « Ajouter un ami » ne trouvait personne
# tant qu'on ne connaissait pas l'identifiant exact. Le parcours d'entrée du produit
# passait par une adresse qu'il fallait déjà avoir.
#
# Ce que ça expose, et qui est assumé (`infra/LIMITES.md`) : n'importe quel compte peut
# **énumérer les autres** par préfixe de nom d'affichage ou d'identifiant. Vérifié dans la
# doc de la version déployée (v1.155, `user_directory.html`) : « all users known to the
# server (matching the search query) will be returned », sans restriction de visibilité.
# Aucun contenu n'entre là-dedans — l'annuaire porte des identifiants et des noms
# d'affichage, jamais de messages, et l'interdit n°3 (`/search`) est intact.
#
# **Après tout changement de ce réglage, l'annuaire doit être reconstruit** — même source :
# « use the admin API and execute the job `regenerate_directory` », c'est-à-dire
# `POST /_synapse/admin/v1/background_updates/start_job` avec `{"job_name":
# "regenerate_directory"}`. Sans cette reprise, les comptes déjà créés restent absent de
# l'index et le réglage paraît sans effet. Procédure dans `infra/README.md`.
user_directory:
  enabled: true
  search_all_users: true

# REQ-INF-07 — DECISIONS D-02 (révisée le 03/08/2026) : rétention illimitée, identique
# DM/groupes. Le bloc est présent explicitement, pas absent par omission — « politique
# définie » veut dire bloc explicite dans la config, pas fonctionnalité active.
#
# `enabled: false`, et surtout pas `true` avec `purge_jobs: []` comme ici auparavant :
# vérifié dans la doc Synapse v1.155, une liste de purge_jobs vide ne désactive rien.
# « If no configuration is provided for this option, a single job will be set up to
# delete expired events in every room daily » — un job de purge quotidien tourne. Et
# `enabled: true` fait honorer les politiques par salon `m.room.retention` : n'importe
# quel client standard posant cet événement d'état déclencherait de vraies purges.
# Deux chemins de suppression que D-02 proscrit.
#
# Rien d'autre dans ce bloc : `default_policy` et `purge_jobs` seraient inertes ici, et
# les laisser rejouerait exactement le malentendu qui a produit le bug.
retention:
  enabled: false

# REQ-INF-08 — backend média S3, blobs opaques uniquement (chiffrement client, spec 08).
# SSE-S3 activé au niveau du bucket (infra/docker-compose.yml, service minio-init) :
# défense en profondeur uniquement, l'opérateur détient ces clés — voir infra/LIMITES.md.
media_storage_providers:
  - module: s3_storage_provider.S3StorageProviderBackend
    store_local: true
    store_remote: true
    store_synchronous: true
    config:
      bucket: "${S3_BUCKET}"
      endpoint_url: "http://minio:9000"
      access_key_id: "${S3_ACCESS_KEY_ID}"
      secret_access_key: "${S3_SECRET_ACCESS_KEY}"

# REQ-INF-09 — seul fournisseur d'authentification : OIDC (Keycloak). Pas de mot de passe
# natif Synapse ; email/pseudo/WebAuthn gérés dans le realm Keycloak (infra/keycloak/).
password_config:
  enabled: false

# REQ-INF-09 — Synapse bloque par défaut ses propres requêtes sortantes vers les
# plages privées (protection SSRF : `ip_range_blacklist` contient 172.16.0.0/12).
# Dès que l'issuer OIDC résout vers une adresse privée — le cas quand ${SERVER_NAME}
# pointe sur le proxy à l'intérieur du réseau Docker — la découverte OIDC expire et
# **tout login répond 503**, sans que rien ne mentionne le blocage dans les logs.
#
# Vide par défaut : la protection reste entière. À ne remplir que si le déploiement
# résout son propre nom en interne, et alors avec la plage la plus étroite possible.
# Voir infra/README.md.
#
# GARDE-FOU : ne pas activer `url_preview_enabled` tant que cette liste n'est pas
# vide, sans avoir d'abord restreint la plage. Aujourd'hui le seul client HTTP
# sortant de Synapse est la découverte OIDC ; avec l'aperçu d'URL, un utilisateur
# qui poste un lien ferait requêter l'intérieur du réseau — Postgres, MinIO,
# Keycloak — par Synapse lui-même. C'est la contrepartie exacte de ce réglage.
ip_range_whitelist: ${SYNAPSE_IP_RANGE_WHITELIST}

oidc_providers:
  - idp_id: keycloak
    idp_name: "Compte"
    issuer: "https://${SERVER_NAME}/auth/realms/tacita"
    client_id: synapse
    client_secret: "${KEYCLOAK_OIDC_CLIENT_SECRET}"
    scopes: ["openid", "profile"]
    user_mapping_provider:
      config:
        localpart_template: "{{ user.preferred_username }}"
        display_name_template: "{{ user.preferred_username }}"

# Rétro-compatibilité media non-authentifiée : comportement vérifié pour v1.155.0
# dans infra/README.md (REQ-INF-12).
